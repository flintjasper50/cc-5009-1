{
  "name": "automotive-interior-material-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Real-time WebGPU material preview bench for procedurally generated automotive interior surfaces",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --experimental-strip-types tests/unit/run.ts",
    "test:e2e": "node tests/e2e/run.mjs"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.65",
    "playwright-core": "1.55.0",
    "typescript": "5.6.3",
    "vite": "6.0.5"
  }
}
